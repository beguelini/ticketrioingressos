# Public browser configuration. Never prefix a credential with VITE_.
VITE_SITE_URL=https://ticketrioingressos.com.br
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Server only: Vercel project ticketrioingressos.
# Use a separate database and scoped user for Preview/Development.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ticketrio
SITE_URL=https://ticketrioingressos.com.br
# Optional additional exact origins, comma separated. Never use a wildcard.
ALLOWED_ORIGINS=

# Email verification, password recovery and staff invitations.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SUPPORT=atendimento@ticketrio.com.br

# Optional gateway; online sales remain disabled until reviewed and tested.
PAGARME_SECRET_KEY=
PAGARME_ACCOUNT_ID=
CRON_SECRET=

# Local bootstrap only. Do not put setup links or passwords in Git.
