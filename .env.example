# Public browser configuration. Never prefix a credential with VITE_.
VITE_SITE_URL=https://ticketrioingressos.com.br
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Server only: Vercel project ticketrioingressos.
# Use a separate database and scoped user for Preview/Development.
DATA_BACKEND=supabase
# Production: ticketrio_app / ticketrio; Preview and Development: ticketrio_preview_app / ticketrio_preview.
# Password must be URL-encoded. Private Supabase session pooler; TLS verified by bundled CA.
SUPABASE_DB_URL=postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_DB_SCHEMA=ticketrio
# Legacy rollback/migration scripts only, never sent to the browser.
MONGODB_URI=
MONGODB_DB=ticketrio
SITE_URL=https://ticketrioingressos.com.br
# Optional additional exact origins, comma separated. Never use a wildcard.
ALLOWED_ORIGINS=

# Email verification, password recovery and staff invitations.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SUPPORT=atendimento@ticketrio.com.br

# Optional gateway; online sales remain disabled until reviewed and tested.
PAGARME_SECRET_KEY=
PAGARME_ACCOUNT_ID=
CRON_SECRET=

# Local bootstrap only. Do not put setup links or passwords in Git.
ADMIN_EMAIL=raulbeguelini29@gmail.com
ADMIN_SETUP_URL=http://localhost:5173

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
