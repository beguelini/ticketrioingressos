# Vite sends every VITE_* variable to the browser. Use only public values here.
VITE_SITE_URL=https://ticketrioingressos.com.br
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Server-only Supabase Edge Functions. Never prefix these with VITE_.
PAGARME_SECRET_KEY=sk_YOUR_PRODUCTION_KEY
PAGARME_ACCOUNT_ID=acc_YOUR_ACCOUNT_ID

# Reserved for future server integrations.
