{
  "name": "ticket-rio-carnaval",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "test:run": "vitest run",
    "preview": "vite preview",
    "dev:api": "node --env-file=.env.local server/mongo/dev.mjs",
    "db:init": "node --env-file=.env.local scripts/init-mongodb.mjs",
    "db:admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-mongodb.mjs"
  },
  "dependencies": {
    "mongodb": "7.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  }
}
